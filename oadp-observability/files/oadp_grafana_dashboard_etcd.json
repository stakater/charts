{
  "panels": [
    {
      "id": 20,
      "type": "row",
      "title": "etcd backups (CronJob-based)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "etcd daily: last successful backup",
      "description": "Age of the last SUCCESSFUL run of the daily etcd-backup CronJob (not the last time it fired: a cron that fires and fails must show red). Red after the configured daily budget (grafana.dashboard.etcdBackup). NEVER = the CronJob exists but has never succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_DAILY__\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "daily",
          "instant": true
        },
        {
          "expr": "(max(kube_cronjob_info{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_DAILY__\"}) unless max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_DAILY__\"})) * 0 - 1",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "daily",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NEVER (no successful backup visible)",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90000
              }
            ]
          },
          "noValue": "No daily CronJob found \u2014 check grafana.dashboard.etcdBackup"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "etcd weekly: last successful backup",
      "description": "Age of the last SUCCESSFUL run of the weekly etcd-backup CronJob (not the last time it fired: a cron that fires and fails must show red). Red after the configured weekly budget (grafana.dashboard.etcdBackup). NEVER = the CronJob exists but has never succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_WEEKLY__\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "weekly",
          "instant": true
        },
        {
          "expr": "(max(kube_cronjob_info{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_WEEKLY__\"}) unless max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_WEEKLY__\"})) * 0 - 1",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "weekly",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NEVER (no successful backup visible)",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 691200
              }
            ]
          },
          "noValue": "No weekly CronJob found \u2014 check grafana.dashboard.etcdBackup"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 23
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "etcd daily backup age (hours)",
      "description": "Hours since the last successful daily etcd-backup run. Dashed line: the daily budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(time() - max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_DAILY__\"})) / 3600",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "__ETCD_DAILY__"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "noValue": "No successful daily run (or no daily CronJob)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 23
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "etcd weekly backup age (days)",
      "description": "Days since the last successful __ETCD_WEEKLY__ run. Dashed line: the 8-day budget. Separate from the hourly chart because the scale differs.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(time() - max(kube_cronjob_status_last_successful_time{namespace=\"__ETCD_NS__\", cronjob=\"__ETCD_WEEKLY__\"})) / 86400",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "etcd weekly"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "noValue": "No successful weekly run (or no weekly CronJob)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 23
      }
    }
  ]
}

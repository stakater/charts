{
  "title": "OADP / Backup Status",
  "uid": "oadp-backup-status",
  "tags": [
    "oadp",
    "velero",
    "backup"
  ],
  "description": "Is every Velero (OADP) backup schedule producing successful backups on time? Per schedule \u2014 last SUCCESS, not last attempt. Runbook: https://github.com/stakater/charts/blob/main/oadp-observability/docs/runbook.md",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Data source"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/stakater/charts/blob/main/oadp-observability/docs/runbook.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Velero: last successful backup",
      "description": "One row per Velero schedule, worst first. Status compares the age of the newest Completed backup with THAT schedule's RPO budget (its oadp-observability.stakater.com/max-age-hours annotation, else the chart default): OK below the budget, STALE above it (OadpBackupStale), NEVER when the schedule exists but no Completed backup is visible (OadpBackupNoSuccessfulBackup). Budget comes from the oadp:schedule_budget_seconds recording rule. NEVER needs the state exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(time() - max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) or (max by (schedule) (kube_customresource_schedule_created) unless on (schedule) max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) * 0 + 1e15",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "((time() - max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) / on (schedule) max by (schedule) (oadp:schedule_budget_seconds)) or (max by (schedule) (kube_customresource_schedule_created) unless on (schedule) max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) * 0 + 1e15",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "max by (schedule) (oadp:schedule_budget_seconds)",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "schedule",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "indexByName": {
              "schedule": 0,
              "Value #B": 1,
              "Value #A": 2,
              "Value #C": 3
            },
            "renameByName": {
              "schedule": "Schedule",
              "Value #A": "Last successful backup (age)",
              "Value #B": "Status",
              "Value #C": "Budget"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "noValue": "No schedules (Velero not scraped?)"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 100000000000000.0,
                      "to": 1e+16,
                      "result": {
                        "text": "NEVER",
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 0,
                      "to": 1,
                      "result": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 100000000000000.0,
                      "result": {
                        "text": "STALE",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last successful backup (age)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 100000000000000.0,
                      "to": 1e+16,
                      "result": {
                        "text": "\u2014",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Budget"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Last successful backup (age)",
            "desc": true
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backup storage locations",
      "description": "Velero BackupStorageLocation phase, per BSL (from this chart's state exporter). Unavailable = every backup to it ends FailedValidation (OadpBackupStorageLocationUnavailable).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "max by (name) (kube_customresource_backupstoragelocation_status_phase{phase=\"Available\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Available",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No data (exporter off?)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backup alerts firing",
      "description": "Backup alerts currently firing: this chart's Oadp* alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"Oadp.*\"}) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Velero backup age / RPO budget",
      "description": "Age of the newest Completed backup divided by the schedule's own RPO budget, per schedule. 1 (dashed line) = the budget: a line crossing it is an RPO breach, whatever the schedule's interval. A gap means no success is visible at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "((time() - max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) / on (schedule) max by (schedule) (oadp:schedule_budget_seconds))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{schedule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Velero backup outcomes",
      "description": "Velero backups finished per interval, by outcome, all schedules (ad-hoc excluded). Completed is the only restorable outcome; FailedValidation on every run usually means the BSL is Unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(increase(velero_backup_success_total{schedule!=\"\"}[$__interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "Completed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_partial_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "PartiallyFailed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "Failed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_validation_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "FailedValidation",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PartiallyFailed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FailedValidation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Backup storage location availability",
      "description": "Per-BSL phase over time. Red spans are windows in which every backup to that location failed validation.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "max by (name) (kube_customresource_backupstoragelocation_status_phase{phase=\"Available\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Available",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Volume data (node-agent)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "node-agent pods unavailable",
      "description": "node-agent DaemonSet pods that aren't ready (kube-state-metrics). On those nodes volume data can't be backed up or restored (OadpNodeAgentUnavailable). No value means the DPA doesn't run a node-agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "max(kube_daemonset_status_number_unavailable{daemonset=\"node-agent\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "No node-agent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Data mover outcomes",
      "description": "Volume-data transfers by the node-agent per interval, all nodes: uploads (backups) and downloads (restores). Failures raise OadpDataMoverFailed. Needs the node-agent PodMonitor; flat zero where no volume data is backed up.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(increase(podVolume_data_upload_success_total[$__interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "upload ok",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(podVolume_data_upload_failure_total[$__interval]))",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "upload failed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(podVolume_data_download_success_total[$__interval]))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "download ok",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(podVolume_data_download_failure_total[$__interval]))",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "download failed",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "noValue": "No node-agent metrics (PodMonitor off?)"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "upload ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "upload failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "download ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "download failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 23
      }
    }
  ]
}

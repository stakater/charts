{
  "title": "OADP / Backup Status",
  "uid": "oadp-backup-status",
  "tags": [
    "oadp",
    "velero",
    "etcd",
    "backup"
  ],
  "description": "Can this cluster be restored? Velero (OADP) backups and, optionally, CronJob-based etcd backups \u2014 last SUCCESS, not last attempt. Runbook: https://github.com/stakater/charts/blob/main/oadp-observability/docs/runbook.md",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Data source"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/stakater/charts/blob/main/oadp-observability/docs/runbook.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Velero: last successful backup",
      "description": "Age of the newest Completed Velero backup, per schedule. Red after the RPO budget (prometheus.rules.velero.backupStale.maxAgeHours, default 25h \u2014 the same budget as OadpBackupStale). NEVER = the schedule exists but no Completed backup is visible (OadpBackupNoSuccessfulBackup).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "time() - max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{schedule}}",
          "instant": true
        },
        {
          "expr": "(max by (schedule) (kube_customresource_schedule_created) unless on (schedule) max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) * 0 - 1",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{schedule}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NEVER (no successful backup visible)",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90000
              }
            ]
          },
          "noValue": "No data (not scraped?)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "etcd daily: last successful backup",
      "description": "Age of the last SUCCESSFUL run of the daily-etcd-backup CronJob (not the last time it fired: a cron that fires and fails daily must show red). Red after 25h. NEVER = the CronJob exists but has never succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"daily-etcd-backup\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "daily",
          "instant": true
        },
        {
          "expr": "(max(kube_cronjob_info{namespace=\"etcd-backup\", cronjob=\"daily-etcd-backup\"}) unless max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"daily-etcd-backup\"})) * 0 - 1",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "daily",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NEVER (no successful backup visible)",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 90000
              }
            ]
          },
          "noValue": "No data (not scraped?)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "etcd weekly: last successful backup",
      "description": "Age of the last SUCCESSFUL run of the weekly-etcd-backup CronJob. Red after 8 days. NEVER = the CronJob exists but has never succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"weekly-etcd-backup\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "weekly",
          "instant": true
        },
        {
          "expr": "(max(kube_cronjob_info{namespace=\"etcd-backup\", cronjob=\"weekly-etcd-backup\"}) unless max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"weekly-etcd-backup\"})) * 0 - 1",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "weekly",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "NEVER (no successful backup visible)",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 691200
              }
            ]
          },
          "noValue": "No data (not scraped?)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 11,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backup storage locations",
      "description": "Velero BackupStorageLocation phase, per BSL (from this chart's state exporter). Unavailable = every backup to it ends FailedValidation (OadpBackupStorageLocationUnavailable).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "max by (name) (kube_customresource_backupstoragelocation_status_phase{phase=\"Available\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Available",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No data (exporter off?)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backup alerts firing",
      "description": "Backup alerts currently firing: this chart's Oadp* alerts plus any etcd-backup alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"Oadp.*|(?i:.*etcd.*backup.*)\"}) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backup age vs RPO (hours)",
      "description": "Hours since the last successful Velero backup (per schedule) and daily etcd backup. The dashed line is the RPO budget (maxAgeHours): a line crossing it is an RPO breach. A gap means no success is visible at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(time() - max by (schedule) (velero_backup_last_successful_timestamp{schedule!=\"\"})) / 3600",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "velero {{schedule}}"
        },
        {
          "expr": "(time() - max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"daily-etcd-backup\"})) / 3600",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "etcd daily"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Velero backup outcomes",
      "description": "Velero backups finished per interval, by outcome, all schedules (ad-hoc excluded). Completed is the only restorable outcome; FailedValidation on every run usually means the BSL is Unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "sum(increase(velero_backup_success_total{schedule!=\"\"}[$__interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "Completed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_partial_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "PartiallyFailed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "Failed",
          "interval": "5m"
        },
        {
          "expr": "sum(increase(velero_backup_validation_failure_total{schedule!=\"\"}[$__interval]))",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "FailedValidation",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PartiallyFailed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FailedValidation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "etcd weekly backup age (days)",
      "description": "Days since the last successful weekly-etcd-backup run. Dashed line: the 8-day budget. Separate from the hourly chart because the scale differs.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "(time() - max(kube_cronjob_status_last_successful_time{namespace=\"etcd-backup\", cronjob=\"weekly-etcd-backup\"})) / 86400",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "etcd weekly"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "noValue": "No successful weekly run (or no weekly CronJob)"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Backup storage location availability",
      "description": "Per-BSL phase over time. Red spans are windows in which every backup to that location failed validation.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "expr": "max by (name) (kube_customresource_backupstoragelocation_status_phase{phase=\"Available\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Available",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unavailable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    }
  ]
}

# Pinned versions for the self-contained integration capture (tests/integration.sh).
# Bumping any of these is the ONLY time you need a cluster: re-run integration.sh to
# regenerate tests/fixtures/*.txt and the captured allowlist, then commit the diff.

# kind node image — pin to a digest-tagged release for reproducibility.
KIND_NODE_IMAGE="kindest/node:v1.31.2"

# Crossplane core. Pinned to the latest stable so the capture verifies the broadest,
# current metric surface (the chart's *deployment* target tracks the roadmap separately).
CROSSPLANE_VERSION="2.3.1"

# provider-kubernetes: creates real in-cluster Objects with NO cloud credentials, on a
# current crossplane-runtime — so the provider emits the crossplane_managed_resource_*
# state metrics (exists/ready/synced/drift) we actually want to verify.
PROVIDER_KUBERNETES_PACKAGE="xpkg.upbound.io/crossplane-contrib/provider-kubernetes:v1.2.1"

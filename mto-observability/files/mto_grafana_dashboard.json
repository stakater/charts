{
  "title": "MTO / Suite Overview",
  "uid": "mto-observability",
  "tags": [
    "mto",
    "multi-tenant-operator",
    "finops",
    "hibernation",
    "templates"
  ],
  "description": "Health of the MTO suite (tenant-operator, finops-operator, hibernation-operator, template-operator-v2): cost-pipeline freshness front and center, per-operator availability, reconciliation convergence, admission webhooks, tenancy state and saturation. Ships with the mto-observability chart; job labels are substituted from the chart's configured series identities (mto.operators.*.job).",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        },
        "label": "Data source",
        "description": "Pick the cluster's own Prometheus/Thanos (includes user-workload metrics). A store without the finops_costjob_* / hibernation_supervisor_* / template_operator_instance_* series reads No data on those panels."
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Finops cost pipeline \u2014 is cost data flowing?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Age of last successful collection",
      "description": "Per CostJob: time since cost data last landed. This is what MTOCostDataStale pages on (threshold 2h by default). A frozen age means the pipeline is silently dead, whatever the cause. Shows 'never' when no CostJob has ever succeeded (the MTOCostJobNeverSucceeded condition).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - finops_costjob_last_successful_execution_timestamp_seconds{job=\"__FINOPS_JOB__\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{costjob}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "never",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "never"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CostJobs failing right now",
      "description": "CostJobs whose LAST execution ended Failed or Error (MTOCostJobFailing).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(finops_costjob_last_execution_status{job=\"__FINOPS_JOB__\", status=~\"Failed|Error\"} == 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CostJobs that never succeeded",
      "description": "CostJobs with status series but no success timestamp ever (MTOCostJobNeverSucceeded): never ran, or every run failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (costjob, namespace, type) (finops_costjob_last_execution_status{job=\"__FINOPS_JOB__\"}) >= 0 unless on (costjob, namespace, type) finops_costjob_last_successful_execution_timestamp_seconds{job=\"__FINOPS_JOB__\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Last execution status (1 = that status is current)",
      "description": "One-hot per CostJob and status. A flat Failed=1 band is a failing loader; all-zero is a job that has never executed.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_costjob_last_execution_status{job=\"__FINOPS_JOB__\"} == 1",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{costjob}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CronJob health (platform view)",
      "description": "kube-state-metrics view of the loader CronJobs/Jobs \u2014 dashboard-only (platform series, not alertable from UWM).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kube_cronjob_status_last_successful_time{cronjob=~\".*-cronjob\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "age {{cronjob}}"
        },
        {
          "refId": "B",
          "expr": "kube_job_status_failed{job_name=~\".*scraping.*\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "failed {{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Suite health \u2014 are the operators alive?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Operator up",
      "description": "min(up) per operator job: 1 = every pod of that operator is scraped and alive. 0 or No data pages via MTO<Op>Down.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (job) (up{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Leaders held",
      "description": "leader_election_master_status summed per job: each single-replica controller should hold exactly its own leases.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (leader_election_master_status{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scrape targets (up) by pod",
      "description": "Every scraped controller pod across the suite. Gaps are restarts or scrape failures.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Certwatcher certificate read errors",
      "description": "A climbing line is a webhook/metrics cert going bad before it becomes an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(certwatcher_read_certificate_errors_total{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Reconciliation \u2014 is tenant state converging?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconcile rate by controller",
      "description": "controller_runtime_reconcile_total rate per operator and controller.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, controller) (rate(controller_runtime_reconcile_total{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}/{{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Reconcile error ratio",
      "description": "Errored share of reconciles per controller; MTO<Op>ReconcileErrors fires above 10% for 15m.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, controller) (rate(controller_runtime_reconcile_errors_total{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval])) / sum by (job, controller) (rate(controller_runtime_reconcile_total{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}/{{controller}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Workqueue depth",
      "description": "Items waiting per queue; sustained depth is slow convergence before anything errors (MTO<Op>WorkqueueBacklog at 50).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (job, name) (workqueue_depth{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__HIBERNATION_JOB__|__TEMPLATE_JOB__\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}}/{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Resources in reconcile error (tenant-operator)",
      "description": "multi_tenant_operator_reconcile_error aggregated WITHOUT its errors label (unbounded cardinality). Non-empty = a tenant-visible promise currently broken; the CR's status carries the message.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (kind, name, namespace, state) (multi_tenant_operator_reconcile_error{job=\"__TENANT_JOB__\"} > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Slowest reconciles (tenant-operator)",
      "description": "topk(10) of multi_tenant_operator_reconcile_seconds: one pathological resource can dominate a controller's cycle.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, multi_tenant_operator_reconcile_seconds{job=\"__TENANT_JOB__\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{kind}}/{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Admission webhooks \u2014 the enforcement point",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Webhook p99 latency",
      "description": "p99 admission latency per webhook: this sits in the write path of everything the webhooks guard (MTO<Op>WebhookLatencyHigh at 1s).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, job, webhook) (rate(controller_runtime_webhook_latency_seconds_bucket{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}} {{webhook}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Webhook requests by code",
      "description": "5xx here are user-visible rejections on Fail-policy webhooks (MTO<Op>WebhookErrors). The hibernation webhook pod exports no metrics yet (upstream gap, SA-tracked).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, code) (rate(controller_runtime_webhook_requests_total{job=~\"__TENANT_JOB__|__FINOPS_JOB__|__TEMPLATE_JOB__\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "legendFormat": "{{job}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Tenancy state \u2014 what has the suite built?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
